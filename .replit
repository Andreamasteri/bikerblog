modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Daily Pipeline (23:30)"

[[workflows.workflow]]
name = "Daily Pipeline (23:30)"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run cluster:daily"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 21881
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
INBOX_URL = "https://biker-link.replit.app/api/_internal/chat-export"
INBOX_SOURCE = "bikerlink"
TC_SSH_HOST = "ssh.biker-link.net"
TC_SSH_USER = "andrea"
QUEBRACHO_OLLAMA_MODEL = "granite4:tiny-h"
AI_HUB_URL = "https://hub.biker-link.net"
NOMINATIM_URL = "https://nominatim.biker-link.net"
WHISPER_URL = "https://whisper.biker-link.net"
VALHALLA_URL = "https://valhalla.biker-link.net"
